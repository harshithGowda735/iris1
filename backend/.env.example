# ==============================================================================
# IRIS Backend — Production Environment Configuration (.env)
# ==============================================================================
# Copy this file to `.env` in the `backend/` directory:
#   cp .env.example .env
#
# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL via AsyncPG)
# ------------------------------------------------------------------------------
# In the Supabase Dashboard, navigate to:
#   Project Settings -> Database -> Connection string / Connection Pooling
#
# Converting Supabase Connection Strings for SQLAlchemy + asyncpg:
# 1. Replace the leading protocol:
#      Change `postgresql://` or `postgres://` to `postgresql+asyncpg://`
# 2. Connection Mode Selection:
#      - Transaction Pooler (Port 6543) [RECOMMENDED for Serverless / FastAPI]:
#        Handles high concurrent connection volume without exhausting Postgres
#        connection limits (Supavisor / PgBouncer).
#        Example format:
#          postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#      - Session Pooler (Port 5432):
#        Alternative pooler mode supporting session-level features.
#        Example format:
#          postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#      - Direct Connection (Port 5432):
#        Direct connection to Postgres (requires IPv6 support or Supabase IPv4 add-on).
#        Example format:
#          postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# NOTE ON TRANSACTION POOLERS & ASYNCPG:
#   When connecting through Port 6543 (Transaction Mode), the application automatically
#   disables prepared statement caching (`statement_cache_size=0`) in database.py
#   to prevent "prepared statement does not exist" errors across pooled connections.
#
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Locate these values in Supabase Dashboard:
#   Project Settings -> API -> Project URL & Project API Keys
#   Project Settings -> API -> JWT Settings -> JWT Secret
#
# Project URL:
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Public anon key (used for client SDKs / public anonymous requests):
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (super-admin bypass; KEEP THIS SECRET — backend only):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (used by the FastAPI backend to verify incoming Bearer tokens locally):
JWT_SECRET=your-supabase-jwt-secret-from-dashboard-api-settings

# JWT signature algorithm used by Supabase (default: HS256):
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 3. APPLICATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Options: development | staging | production
APP_ENV=development
DEBUG=true

# Allowed CORS origins (JSON array or comma-separated list):
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Pagination thresholds
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=200
